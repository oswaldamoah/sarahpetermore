# ---- Browser (Neon Console → your project) ----
# Auth → Configuration → Auth URL
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.c-2.eu-central-1.aws.neon.tech/neondb/auth
# Data API → API URL
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.eu-central-1.aws.neon.tech/neondb/rest/v1

# ---- Server only (Vercel → Settings → Environment Variables; never prefix with VITE_) ----
# Neon → Connect → owner connection string (used by the assistants and alerts)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Same Data API URL as above (server copy)
NEON_DATA_API_URL=https://ep-xxxx.apirest.c-2.eu-central-1.aws.neon.tech/neondb/rest/v1
# Created automatically when you add a Blob store to the Vercel project
BLOB_READ_WRITE_TOKEN=
# Optional: AI keys as env vars instead of Admin → Settings → AI models
# AI_KEY_OPENROUTER=  AI_KEY_GROQ=  AI_KEY_GEMINI=
# Optional alerts
# Email alerts (Resend, free 100/day). Recipients are managed in Admin → Settings → Order alerts.
# Without a verified domain, Resend only delivers to the email you signed up to Resend with.
# RESEND_API_KEY=
# ALERT_EMAIL_FROM=orders@yourdomain.com   (only after verifying yourdomain.com in Resend)

# WhatsApp link (npm run whatsapp): links your own WhatsApp like WhatsApp Web.
# WA_AI_MODE=customers     customers | everyone | off
# WA_NOTIFY_SELF=true      send alerts to your own "Message yourself" chat
# CRON_SECRET=   (Vercel sets this for cron jobs)
SITE_URL=https://your-domain.com
